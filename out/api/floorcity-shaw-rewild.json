          }
        }

        const productIdMeta = document.querySelector('meta[property="product:id"]');

        if (productIdMeta) {
          return { id: productIdMeta.content };
        }

        return null;
      }

      fetchStampedData() {
        if (!this.productId) return;

        const apiKey = this.getStampedApiKey();
        if (!apiKey) return;

        fetch(`https://stamped.io/api/widget/reviews?productId=${this.productId}&apiKey=${apiKey}`)
          .then(response => response.json())
          .then(data => {
            if (data && data.rating !== undefined && data.count !== undefined) {
              this.updateRating(data.rating, data.count);
            }
          })
          .catch(error => {
            console.error('Error fetching Stamped.io data:', error);
          });
      }

      getStampedApiKey() {
        const stampedScript = document.querySelector('script[src*="stamped.io"]');

        if (stampedScript) {
          const match = stampedScript.src.match(/apiKey=([^&]+)/);
          if (match) return match[1];
        }

        if (window.StampedFn && window.StampedFn.apiKey) {
          return window.StampedFn.apiKey;
        }

        return null;
      }

      formatReviewCount(count) {
        const numericCount = Number(count);

        if (!Number.isFinite(numericCount)) {
          return count;
        }

        return new Intl.NumberFormat('en-US').format(numericCount);
      }

      getStarMarkup(fillPercent) {
        const starColor = "#cc0000";
        const emptyStarColor = "#e0e0e0";

        return `
          <span class="ai-announcement-bar__star-au1porlvlwupls2rrraigenblock0e49e58announcementbar7u88gy">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="${emptyStarColor}" stroke="none">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span class="ai-announcement-bar__star-fill-au1porlvlwupls2rrraigenblock0e49e58announcementbar7u88gy" style="width: ${fillPercent}%;">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="${starColor}" stroke="none">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </span>
          </span>
        `;
      }

      updateRating(rating, count) {
        const ratingContainer = this.querySelector('[data-rating-container]');
        const countContainer = this.querySelector('[data-count-container]');

        if (!ratingContainer || !countContainer) return;

        const numericRating = Number(rating);
        const safeRating = Number.isFinite(numericRating) ? Math.max(0, Math.min(5, numericRating)) : 4.8;

        ratingContainer.innerHTML = '';

        for (let i = 1; i <= 5; i++) {
          const starStart = i - 1;
          const fillPercent = Math.max(0, Math.min(100, (safeRating - starStart) * 100));
          ratingContainer.insertAdjacentHTML('beforeend', this.getStarMarkup(fillPercent));
        }

        const suffix = "+";
        const reviewsText = "Reviews";
        countContainer.textContent = `${this.formatReviewCount(count)}${suffix} ${reviewsText}`;
      }
    }

    customElements.define('announcement-bar-au1porlvlwupls2rrraigenblock0e49e58announcementbar7u88gy', AnnouncementBarau1porlvlwupls2rrraigenblock0e49e58announcementbar7u88gy);
  })();
