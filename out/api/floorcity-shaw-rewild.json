    pointer-events: auto !important;
    z-index: 99999 !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
  }
  #mobile-collection-filters.is-open .drawer__inner,
  #mobile-collection-filters.is-open .collection-drawer {
    transform: none !important;
    height: 100% !important;
    overflow-y: auto !important;
    background: #fff !important;
  }
  /* Force EVERY filter options panel inside the drawer open and tappable */
  #mobile-collection-filters .collection__filter-collapsible {
    height: auto !important;
    max-height: none !important;
    overflow: visible !important;
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    display: block !important;
  }
  #mobile-collection-filters .collection__filter-collapsible input,
  #mobile-collection-filters .collection__filter-collapsible label,
  #mobile-collection-filters .color-swatch,
  #mobile-collection-filters .collection__filter-checkbox {
    pointer-events: auto !important;
  }
  /* Hide the collapse arrows since panels are always open here */
  #mobile-collection-filters .collection__filter-group-name [data-action] svg,
  #mobile-collection-filters .collection__filter-group-name .icon--arrow-bottom {
    display: none !important;
  }

  /* ---- Desktop top filter bar ---- */
  .fc-fallback-notice {
    margin: 16px 24px;
    padding: 12px 16px;
    background: #fff8e1;
    border: 1px solid #f1d27a;
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.4;
    color: #6b5300;
  }
  .collection__top-filters-row {
    padding: 16px 24px;
    margin: 0;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    overflow: visible;
  }

  /* ---- Mobile: filter + sort + chips attached to bottom of header ---- */
  @media (max-width: 1023px) {
    /* Kill theme spacing above the filter row so it sits flush under search */
    .page__content,
    .collection,
    .collection .card,
    .collection__dynamic-part {
      margin-top: 0 !important;
      padding-top: 0 !important;
      overflow: visible !important;
    }

    /* Hide the "Products for..." title block on mobile so the filter row
       sits directly under the search header. */
    .collection .card__header.card__header--tight {
      display: none !important;
    }

    /* Sticky filter row pinned below the FULL black header section (header
       height + the black padding beneath the search box) so it can never
       cover the search. Adjust --fc-header-clear if needed. */
    .fc-sticky-filters {
      position: sticky;
      top: var(--fc-header-clear, 120px) !important;
      z-index: 40;
      margin: 0 !important;
      padding: 0 !important;
      background: #fff;
      border-bottom: 1px solid rgba(0,0,0,0.12);
      box-shadow: none !important;
    }

    .fc-sticky-filters .collection__toolbar {
      min-height: 64px;
      padding: 0 20px !important;
      margin: 0 !important;
      display: flex;
      align-items: center;
      background: #fff;
    }

    .collection__toolbar-item {
      display: flex;
      align-items: center;
    }
    .collection__toolbar-item--filter { justify-content: flex-start; }
    .collection__toolbar-item--sort { justify-content: flex-end; margin-left: auto; }

    .collection__mobile-filters-recap {
      margin: 0 !important;
      padding: 8px 20px 10px !important;
      border-top: 1px solid rgba(0,0,0,0.08);
      background: #fff;
    }

    .product-list.product-list--collection {
      padding-top: 14px !important;
    }

    /* When scrolled (stuck), hide the active-filter chips row */
    .fc-sticky-filters.is-stuck .collection__mobile-filters-recap {
      display: none !important;
    }
  }
  .collection__top-filters {
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
    align-items: center;
    justify-content: flex-start;
    margin: 0;
    overflow: visible;
  }
  /* A filter pushed into the overflow "More" menu */
  .top-filter.is-overflowed {
    display: none;
  }
  /* The More button + its panel */
  .top-filter--more {
    position: relative;
    margin-left: auto;
  }
  .top-filter--more.is-empty {
    display: none;
  }
  .top-filter--more .top-filter__panel {
    right: 0;
    left: auto;
  }
  .top-filter--more .top-filter__panel .top-filter {
    display: block;
    position: static;
    margin-bottom: 6px;
  }
  .top-filter--more .top-filter__panel .top-filter__panel {
    position: static;
    box-shadow: none;
    border: none;
    padding: 6px 0 6px 10px;
    min-width: 0;
  }
  .top-filter {
    position: relative;
  }
  .top-filter:has(.top-filter__panel[aria-hidden="false"]) {
    z-index: 9999;
  }
  .top-filter__button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: 1px solid rgba(0,0,0,0.15);
    border-radius: 6px;
    background: #fff;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }
  .top-filter__button svg {
    width: 12px;
    height: 12px;
    transition: transform 0.15s ease;
  }
  .top-filter__button[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  .top-filter__panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 9998;
    min-width: 220px;
    max-height: 360px;
    overflow-y: auto;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.15);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    padding: 12px 14px;
  }
  .top-filter__panel[aria-hidden="true"] {
    display: none;
  }
  .top-filter__panel[aria-hidden="false"] {
    display: block;
  }
</style>

<script>
  (function () {
    var section = document.querySelector('[data-section-id="template--24406370091065__main"]');
    if (!section) return;

    // ---- Auto-fallback when a filter combination yields zero results ----
    (function () {
      var STORE_KEY = 'fc_last_good_search';
      var resultsCount = 10;
      var performed = true;
      var hasActiveFilters = 0 > 0;
      var baseUrl = "\/search"
        + '?q=' + encodeURIComponent("rewild")
        + '&type=product&sort_by=' + encodeURIComponent("relevance");
      var currentUrl = window.location.pathname + window.location.search;

      function storedGood() {
        try { return sessionStorage.getItem(STORE_KEY); } catch (e) { return null; }
      }
      function setGood(url) {
        try { sessionStorage.setItem(STORE_KEY, url); } catch (e) {}
      }

      if (!performed) return;

      // Build a fallback URL: drop the most recently added filter param if we
      // can infer it, otherwise use the last-good URL, otherwise base search.
      function fallbackUrl() {
        var good = storedGood();
        if (good && good !== currentUrl) return good;
        return baseUrl;
      }

      if (resultsCount > 0) {
        // This combination works — remember it.
        setGood(currentUrl);
      } else if (hasActiveFilters) {
        // Zero results with filters applied -> revert to last good combination.
        var target = fallbackUrl();
        if (target && target !== currentUrl) {
          try { sessionStorage.setItem('fc_fallback_notice', '1'); } catch (e) {}
          window.location.replace(target);
          return;
        }
      }

      // Show a one-time notice after a fallback redirect lands
      try {
        if (sessionStorage.getItem('fc_fallback_notice') === '1') {
          sessionStorage.removeItem('fc_fallback_notice');
          var anchor = section.querySelector('[data-fc-results-anchor]');
          if (anchor) {
            var note = document.createElement('div');
            note.className = 'fc-fallback-notice';
            note.textContent = 'Some filters had no matching products and were removed.';
            anchor.parentNode.insertBefore(note, anchor);
            setTimeout(function () {
              if (note && note.parentNode) note.parentNode.removeChild(note);
            }, 6000);
          }
        }
      } catch (e) {}
    })();

    // Active-filter chips and "Clear all": navigate to their data-url
    section.addEventListener('click', function (e) {
      var clearBtn = e.target.closest('[data-action="clear-filters"]');
      if (!clearBtn) return;
      var url = clearBtn.getAttribute('data-url');
      if (!url) return;
      e.preventDefault();
      e.stopPropagation();
      window.location.href = url;
    }, true);

    var drawer = section.querySelector('#mobile-collection-filters');
    if (!drawer) return;
    function openDrawer() {
      drawer.setAttribute('aria-hidden', 'false');
      drawer.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      // Force-expand every options panel so nothing needs toggling
      drawer.querySelectorAll('.collection__filter-collapsible').forEach(function (p) {
        p.setAttribute('aria-hidden', 'false');
        p.style.height = 'auto';
        p.style.overflow = 'visible';
      });
    }

    function closeDrawer() {
      drawer.setAttribute('aria-hidden', 'true');
      drawer.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    var openBtn = section.querySelector('[data-action="open-drawer"][aria-controls="mobile-collection-filters"]');
    if (openBtn) {
      openBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        openDrawer();
      }, true);
    }

    drawer.querySelectorAll('[data-action="close-drawer"]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        closeDrawer();
      }, true);
    });

    // Stop the theme's collapse handler from running inside the drawer —
    // panels are already forced open, so the category headers should do nothing.
    drawer.querySelectorAll('[data-action="toggle-collapsible"]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
      }, true);
    });

    // ---- Instant filtering: navigate the moment a filter changes ----
    var baseParams = {
      q: "rewild",
      type: 'product',
      sort_by: "relevance"
    };

    function buildFilteredUrl(formEl) {
      var params = new URLSearchParams();
      params.set('q', baseParams.q);
      params.set('type', baseParams.type);
      if (baseParams.sort_by) params.set('sort_by', baseParams.sort_by);

      // Gather every checked/filled filter input in this form
      formEl.querySelectorAll('input').forEach(function (input) {
        var name = input.getAttribute('name');
        if (!name || name === 'q' || name === 'type' || name === 'sort_by') return;

        if (input.type === 'checkbox') {
          if (input.checked) params.append(name, input.value);
        } else if (input.type === 'number' || input.type === 'text' || input.type === 'hidden') {
          if (input.value !== '' && input.value != null) params.append(name, input.value);
        }
      });

      return "\/search" + '?' + params.toString();
    }

    function wireInstantFilter(formId) {
      var formEl = document.getElementById(formId);
      if (!formEl) return;

      var navigating = false;
      function go() {
        if (navigating) return;
        navigating = true;
        window.location.href = buildFilteredUrl(formEl);
      }

      // Native change (works where the theme doesn't block it)
      formEl.addEventListener('change', function (e) {
        var t = e.target;
        if (t && t.tagName === 'INPUT' && t.type === 'checkbox') go();
      });

      // Tap on label/swatch: explicitly toggle the linked checkbox, then navigate.
      // Capture phase so we run before any theme handler that might swallow it.
      formEl.addEventListener('click', function (e) {
        var label = e.target.closest('label[for]');
        if (!label) return;
        var input = document.getElementById(label.getAttribute('for'));
        if (!input || input.type !== 'checkbox') return;
        e.preventDefault();
        e.stopPropagation();
        input.checked = !input.checked;
        go();
      }, true);
    }

    wireInstantFilter('desktop-filters-form');
    wireInstantFilter('mobile-collection-filters-form');
    wireInstantFilter('top-filters-form');

    // ---- Desktop top filter bar dropdowns ----
    section.querySelectorAll('[data-action="open-top-filter"]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute('aria-controls');
        var panel = id ? document.getElementById(id) : null;
        if (!panel) return;
        var isOpen = panel.getAttribute('aria-hidden') === 'false';
        // close other top-filter panels
        section.querySelectorAll('.top-filter__panel[aria-hidden="false"]').forEach(function (p) {
          p.setAttribute('aria-hidden', 'true');
        });
        section.querySelectorAll('[data-action="open-top-filter"]').forEach(function (b) {
          b.setAttribute('aria-expanded', 'false');
        });
        panel.setAttribute('aria-hidden', isOpen ? 'true' : 'false');
        btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      }, true);
    });

    // Close top-filter dropdowns when clicking outside
    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('.top-filter')) return;
      section.querySelectorAll('.top-filter__panel[aria-hidden="false"]').forEach(function (p) {
        p.setAttribute('aria-hidden', 'true');
      });
      section.querySelectorAll('[data-action="open-top-filter"]').forEach(function (b) {
        b.setAttribute('aria-expanded', 'false');
      });
    });

    // ---- Single-row overflow: move filters that don't fit into "More" ----
    var topForm = document.getElementById('top-filters-form');
    if (topForm) {
      var moreWrap = topForm.querySelector('.top-filter--more');
      var morePanel = topForm.querySelector('#top-filter-more-panel');

      function getFilters() {
        // All real filters, wherever they currently live (bar or More panel)
        var inBar = Array.prototype.slice.call(
          topForm.querySelectorAll(':scope > .top-filter:not(.top-filter--more)')
        );
        var inMore = morePanel
          ? Array.prototype.slice.call(morePanel.querySelectorAll(':scope > .top-filter'))
          : [];
        return inBar.concat(inMore);
      }

      function layoutOverflow() {
        if (!moreWrap || !morePanel) return;

        // 1) Put EVERYTHING back into the bar and make it visible to measure.
        var filters = getFilters();
        filters.forEach(function (f) {
          f.classList.remove('is-overflowed');
          if (f.parentElement === morePanel) {
            topForm.insertBefore(f, moreWrap);
          }
        });
        moreWrap.classList.add('is-empty');

        // 2) Measure with everything visible.
        var available = topForm.clientWidth;
        if (available === 0) return; // not rendered yet

        var gap = 10;
        var widths = filters.map(function (f) { return f.offsetWidth + gap; });
        var total = widths.reduce(function (a, b) { return a + b; }, 0);

        // 3) If it all fits, leave everything in the bar.
        if (total <= available) return;

        // 4) Otherwise reserve room for More and push the tail into it.
        var moreWidth = moreWrap.offsetWidth ? moreWrap.offsetWidth + gap : 100;
        var budget = available - moreWidth;
        var used = 0;
        var overflowed = [];

        filters.forEach(function (f, i) {
          if (used + widths[i] > budget) {
            overflowed.push(f);
          } else {
            used += widths[i];
          }
        });

        // Always keep at least one filter visible in the bar.
        if (overflowed.length === filters.length && filters.length > 0) {
          overflowed.shift();
        }

        if (overflowed.length === 0) return;

        overflowed.forEach(function (f) {
          morePanel.appendChild(f);
          f.classList.add('is-overflowed');
        });
        moreWrap.classList.remove('is-empty');
      }

      function scheduleLayout() {
        window.requestAnimationFrame(layoutOverflow);
      }

      // Inside the More panel, clicking a filter name reveals its options inline
      morePanel.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-action="open-top-filter"]');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute('aria-controls');
        var panel = id ? document.getElementById(id) : null;
        if (!panel) return;
        var isOpen = panel.getAttribute('aria-hidden') === 'false';
        panel.setAttribute('aria-hidden', isOpen ? 'true' : 'false');
        btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      }, true);

      var rt;
      window.addEventListener('resize', function () {
        clearTimeout(rt);
        rt = setTimeout(scheduleLayout, 120);
      });

      // ResizeObserver catches container/sidebar width changes too
      if (window.ResizeObserver) {
        var ro = new ResizeObserver(function () { scheduleLayout(); });
        ro.observe(topForm);
      }

      // Run after fonts/layout settle to avoid mis-measuring on first paint
      scheduleLayout();
      window.addEventListener('load', scheduleLayout);
    }

    // ---- Mobile: toggle is-stuck to hide chips once scrolled ----
    var stickyBar = section.querySelector('.fc-sticky-filters');
    if (stickyBar) {
      var stuckThreshold = 8;
      var barTop = null;

      function measureBarTop() {
        var rect = stickyBar.getBoundingClientRect();
        barTop = rect.top + window.pageYOffset;
      }

      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () {
          if (barTop === null) measureBarTop();
          if (window.pageYOffset > barTop + stuckThreshold) {
            stickyBar.classList.add('is-stuck');
          } else {
            stickyBar.classList.remove('is-stuck');
          }
          ticking = false;
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', function () { barTop = null; onScroll(); });
      measureBarTop();
      onScroll();
    }

    // ---- Sort & per-page: open the picker and navigate on choice ----
    function currentFilterParams() {
      // Read whichever filter form is present so sort preserves active filters
      var formEl = document.getElementById('desktop-filters-form')
        || document.getElementById('mobile-collection-filters-form');
      var params = new URLSearchParams();
      params.set('q', baseParams.q);
      params.set('type', baseParams.type);
      if (formEl) {
        formEl.querySelectorAll('input').forEach(function (input) {
          var name = input.getAttribute('name');
          if (!name || name === 'q' || name === 'type' || name === 'sort_by') return;
          if (input.type === 'checkbox') {
            if (input.checked) params.append(name, input.value);
          } else if (input.value !== '' && input.value != null) {
            params.append(name, input.value);
          }
        });
      }
      return params;
    }

    // Open/close the value-picker dropdowns (theme JS doesn't bind here)
    section.querySelectorAll('[data-action="open-value-picker"]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute('aria-controls');
        var picker = id ? document.getElementById(id) : null;
        if (!picker) return;
        var isOpen = picker.getAttribute('aria-hidden') === 'false';
        // close any other open pickers
        section.querySelectorAll('.value-picker[aria-hidden="false"]').forEach(function (p) {
          p.setAttribute('aria-hidden', 'true');
        });
        picker.setAttribute('aria-hidden', isOpen ? 'true' : 'false');
      }, true);
    });

    section.querySelectorAll('[data-action="close-value-picker"]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute('aria-controls');
        var picker = id ? document.getElementById(id) : null;
        if (picker) picker.setAttribute('aria-hidden', 'true');
      }, true);
    });

    // Selecting a value: sort options navigate; per-page sets a cart attr is
    // theme-specific, so for per-page we just append it as a 'display' param.
    section.querySelectorAll('[data-action="select-value"]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var value = btn.getAttribute('data-value');
        if (!value) return;

        var picker = btn.closest('.value-picker');
        var isSort = picker && picker.id === 'sort-by-selector';

        var params = currentFilterParams();
        if (isSort) {
          params.set('sort_by', value);
        } else {
          // per-page selector
          if (baseParams.sort_by) params.set('sort_by', baseParams.sort_by);
          params.set('display', value);
        }
        window.location.href = "\/search" + '?' + params.toString();
      }, true);
    });
  })();
</script>

