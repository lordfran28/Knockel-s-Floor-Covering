    <script>
      (function () {
        var lastBtnText = '';
        var lastSig = '';
        var lastTs = 0;

        function getCurrency() {
          try {
            if (window.Shopify && Shopify.currency && Shopify.currency.active) return Shopify.currency.active;
          } catch (e) {}
          return 'USD';
        }

        function dedupe(sig) {
          var now = Date.now();
          if (sig === lastSig && now - lastTs < 800) return true;
          lastSig = sig;
          lastTs = now;
          return false;
        }

        function parseQty(body) {
          try {
            if (!body) return 1;
            if (typeof body === 'string') {
              var p = new URLSearchParams(body);
              return parseInt(p.get('quantity') || '1', 10) || 1;
            }
            if (body instanceof URLSearchParams) return parseInt(body.get('quantity') || '1', 10) || 1;
            if (body instanceof FormData) return parseInt(body.get('quantity') || '1', 10) || 1;
            if (typeof body === 'object') return parseInt(body.quantity || 1, 10) || 1;
          } catch (e) {}
          return 1;
        }

        function pushManualATC(item, qty, source) {
          var variantId = item && (item.id || item.variant_id);
          if (!variantId) return;

          var unitCents = item.final_price != null ? item.final_price : item.price != null ? item.price : 0;
          var lineCents =
            item.final_line_price != null
              ? item.final_line_price
              : item.line_price != null
              ? item.line_price
              : unitCents * (qty || 1);

          var price = Number((unitCents / 100).toFixed(2));
          var value = Number((lineCents / 100).toFixed(2));
          var sig = String(variantId) + '|' + String(qty || 1) + '|' + String(value);

          if (dedupe(sig)) return;

          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'manual_add_to_cart',
            tracking_type: 'manual_setup',
            button_text: lastBtnText || '',
            source: source || '',
            ecommerce: {
              currency: getCurrency(),
              value: value,
              items: [
                {
                  item_id: String(variantId),
                  item_name: item.product_title || item.title || item.name || document.title || 'Product',
                  price: price,
                  quantity: qty || 1,
                },
              ],
            },
          });

          console.log('Manual ATC pushed', {
            variantId: variantId,
            qty: qty || 1,
            value: value,
            currency: getCurrency(),
            button_text: lastBtnText,
            source: source,
          });
          lastBtnText = '';
        }

        // Save last clicked button text (Add to cart vs Add to quote vs Get a quote)
        document.addEventListener(
          'click',
          function (e) {
            var btn = e.target.closest(
              '[data-action="add-to-cart"], [name="add"], .add-to-cart, button[type="submit"]'
            );
            if (btn) lastBtnText = (btn.innerText || btn.textContent || '').trim();
          },
          true
        );

        // Intercept fetch calls to /cart/add
        if (window.fetch) {
          var origFetch = window.fetch;
          window.fetch = function (input, init) {
            var url = typeof input === 'string' ? input : input && input.url ? input.url : '';
            var isAdd = url && url.indexOf('/cart/add') !== -1;
            var qtyGuess = init ? parseQty(init.body) : 1;

            return origFetch.apply(this, arguments).then(function (res) {
              if (!isAdd) return res;
              res
                .clone()
                .json()
                .then(function (json) {
                  pushManualATC(json, qtyGuess, 'fetch');
                })
                .catch(function () {});
              return res;
            });
          };
        }

        // Intercept XHR calls to /cart/add
        (function () {
          var open = XMLHttpRequest.prototype.open;
          var send = XMLHttpRequest.prototype.send;

          XMLHttpRequest.prototype.open = function (method, url) {
            this.__fc_url = url || '';
            return open.apply(this, arguments);
          };

          XMLHttpRequest.prototype.send = function (body) {
            this.__fc_qty = parseQty(body);
            this.addEventListener('load', function () {
              try {
                if (!this.__fc_url || this.__fc_url.indexOf('/cart/add') === -1) return;
                var json = JSON.parse(this.responseText);
                pushManualATC(json, this.__fc_qty || 1, 'xhr');
              } catch (e) {}
            });
            return send.apply(this, arguments);
          };
        })();
      })();
    </script>

    <script>
      document.addEventListener(
        'click',
        function (e) {
          var quoteBtn = e.target.closest('.sobefy-quote-button, #order-quote-button');

          if (quoteBtn && quoteBtn.innerText.trim().toLowerCase().includes('quote')) {
            sessionStorage.setItem('quoteClickedSession', 'true');
            sessionStorage.removeItem('pickupClicked');
            console.log('Quote session set from product page');
          }

          var addToCartBtn = e.target.closest('button[data-action="add-to-cart"]');

          if (
            addToCartBtn &&
            !addToCartBtn.classList.contains('sobefy-quote-button') &&
            !addToCartBtn.innerText.trim().toLowerCase().includes('quote')
          ) {
            sessionStorage.removeItem('quoteClickedSession');
            sessionStorage.removeItem('pickupClicked');
            console.log('Quote session cleared from normal add to cart');
          }
        },
        true
      );
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var FC_STAMPED_RUNNING = false;
        var FC_OBSERVER_TIMER = null;
        var FC_LOADING_STARTED_AT = 0;
        var FC_LOADING_TIMER = null;

        function getPage() {
          return document.querySelector('#stamped-full-page');
        }

        function getImageUrl(img) {
          if (!img) return '';

          return (
            img.getAttribute('src') ||
            img.getAttribute('data-src') ||
            img.getAttribute('data-original') ||
            img.getAttribute('data-lazy') ||
            img.getAttribute('data-lazy-src') ||
            ''
          );
        }

        function copyImageAttributes(sourceImg, targetImg) {
          if (!sourceImg || !targetImg) return;

          Array.prototype.slice.call(sourceImg.attributes).forEach(function (attr) {
            if (attr.name === 'src') return;
            targetImg.setAttribute(attr.name, attr.value);
          });
        }

        function openOriginalStampedImage(originalImg) {
          if (!originalImg) return;

          var clickableParent = originalImg.closest('a, button, [role="button"]');

          if (clickableParent) {
            var event = new MouseEvent('click', {
              bubbles: true,
              cancelable: true,
              view: window,
            });

            clickableParent.dispatchEvent(event);
            return;
          }

          var imgEvent = new MouseEvent('click', {
            bubbles: true,
            cancelable: true,
            view: window,
          });

          originalImg.dispatchEvent(imgEvent);
        }

        function getMovableReviewImageNode(img, card) {
          if (!img || !card) return null;

          var clickable = img.closest('a, button, [role="button"]');

          if (clickable && card.contains(clickable)) {
            return clickable;
          }

          var parent = img.parentElement;

          if (
            parent &&
            parent !== card &&
            card.contains(parent) &&
            !parent.classList.contains('fc-card-header') &&
            !parent.classList.contains('fc-purchased-item') &&
            !parent.classList.contains('fc-review-gallery')
          ) {
            return parent;
          }

          return img;
        }

        function findRealProductLink(productNode) {
          if (!productNode) return '#';

          if (productNode.tagName && productNode.tagName.toLowerCase() === 'a') {
            return productNode.getAttribute('href') || '#';
          }

          var parentLink = productNode.closest('a');
          if (parentLink) return parentLink.getAttribute('href') || '#';

          var childLink = productNode.querySelector && productNode.querySelector('a');
          if (childLink) return childLink.getAttribute('href') || '#';

          return '#';
        }

        function sortReviewsWithImagesFirst() {
          var page = getPage();
          if (!page) return;

          var grid = page.querySelector('.fc-stamped-review-grid');
          if (!grid) return;

          var cards = Array.prototype.slice.call(
            grid.querySelectorAll('.stamped-review-card, .stamped-ratings-wrapper.stamped-review-card')
          );

          if (!cards.length) return;

          cards.sort(function (a, b) {
            var aHasReviewImage = !!a.querySelector('.fc-review-gallery img');
            var bHasReviewImage = !!b.querySelector('.fc-review-gallery img');

            if (aHasReviewImage === bHasReviewImage) return 0;

            return aHasReviewImage ? -1 : 1;
          });

          cards.forEach(function (card) {
            grid.appendChild(card);
          });
        }

        function isSafeToRemoveImageWrapper(wrapper, card) {
          if (!wrapper || wrapper === card) return false;
          if (wrapper.closest('.fc-card-header')) return false;
          if (wrapper.closest('.fc-purchased-item')) return false;
          if (wrapper.closest('.fc-review-gallery')) return false;

          if (
            wrapper.querySelector('.stamped-reviews-author') ||
            wrapper.querySelector('.stamped-reviews-date') ||
            wrapper.querySelector('.stamped-reviews-rating') ||
            wrapper.querySelector('.stamped-reviews-title') ||
            wrapper.querySelector('.stamped-reviews-message') ||
            wrapper.querySelector('.stamped-products-reviews-title')
          ) {
            return false;
          }

          return true;
        }

        function removeImageAndWrapper(img, card) {
          if (!img) return;

          var wrapper = img.parentElement;

          img.classList.add('fc-hidden-original-image');
          img.style.display = 'none';

          if (isSafeToRemoveImageWrapper(wrapper, card)) {
            wrapper.classList.add('fc-remove-node');
            wrapper.style.display = 'none';
            wrapper.style.height = '0';
            wrapper.style.minHeight = '0';
            wrapper.style.maxHeight = '0';
            wrapper.style.margin = '0';
            wrapper.style.padding = '0';
            wrapper.style.overflow = 'hidden';
          }
        }

        function removeTopBlankNodes(card) {
          var header = card.querySelector('.fc-card-header');
          if (!header) return;

          var children = Array.prototype.slice.call(card.children);

          for (var i = 0; i < children.length; i++) {
            var node = children[i];

            if (node === header) break;

            if (
              node.classList.contains('fc-remove-node') ||
              node.classList.contains('fc-hidden-original-image-wrap') ||
              node.querySelector('img')
            ) {
              node.classList.add('fc-remove-node');
              node.style.display = 'none';
              node.style.height = '0';
              node.style.minHeight = '0';
              node.style.maxHeight = '0';
              node.style.margin = '0';
              node.style.padding = '0';
              node.style.overflow = 'hidden';
            }
          }
        }

        function resetCard(card) {
          card.querySelectorAll('.fc-card-header, .fc-purchased-item, .fc-review-gallery').forEach(function (node) {
            node.remove();
          });

          card
            .querySelectorAll(
              '.fc-author-original, .fc-date-original, .fc-badge-original, .fc-hide-original-product-link, .fc-hidden-original-image, .fc-hidden-original-image-wrap, .fc-remove-node'
            )
            .forEach(function (node) {
              node.classList.remove(
                'fc-author-original',
                'fc-date-original',
                'fc-badge-original',
                'fc-hide-original-product-link',
                'fc-hidden-original-image',
                'fc-hidden-original-image-wrap',
                'fc-remove-node'
              );

              node.style.display = '';
              node.style.height = '';
              node.style.minHeight = '';
              node.style.maxHeight = '';
              node.style.margin = '';
              node.style.padding = '';
              node.style.overflow = '';
            });

          card.removeAttribute('data-fc-polished');
        }

        function resetAllCards() {
          var page = getPage();
          if (!page) return;

          page
            .querySelectorAll('.stamped-ratings-wrapper.stamped-review-card, .stamped-review-card')
            .forEach(function (card) {
              resetCard(card);
            });
        }

        function ensureGrid() {
          var page = getPage();
          if (!page) return null;

          var cards = Array.prototype.slice
            .call(page.querySelectorAll('.stamped-ratings-wrapper.stamped-review-card, .stamped-review-card'))
            .filter(function (card) {
              return !card.classList.contains('fc-generated-node');
            });

          if (!cards.length) return null;

          var grid = page.querySelector('.fc-stamped-review-grid');

          if (!grid) {
            grid = document.createElement('div');
            grid.className = 'fc-stamped-review-grid';
            cards[0].parentNode.insertBefore(grid, cards[0]);
          }

          cards.forEach(function (card) {
            if (card.parentNode !== grid) {
              grid.appendChild(card);
            }
          });

          return grid;
        }

        function buildHeader(card, author, date, badge, rating, type) {
          var authorText = author ? author.textContent.trim() : '';
          var dateText = date ? date.textContent.trim() : '';

          var header = document.createElement('div');
          header.className = 'fc-card-header fc-generated-node';

          if (type !== 'site' && !badge) {
            header.classList.add('fc-no-badge');
          }

          var headerLeft = document.createElement('div');
          headerLeft.className = 'fc-card-header__left';

          var avatar = document.createElement('div');
          avatar.className = type === 'site' ? 'fc-site-avatar' : 'fc-product-avatar';
          avatar.textContent = authorText ? authorText.charAt(0).toUpperCase() : 'C';

          var meta = document.createElement('div');
          meta.className = type === 'site' ? 'fc-site-info' : 'fc-card-header__meta';

          if (authorText) {
            var nameNode = document.createElement('div');
            nameNode.className = 'fc-card-header__name';
            nameNode.textContent = authorText;
            meta.appendChild(nameNode);
          }

          if (badge && type !== 'site') {
            var badgeClone = badge.cloneNode(true);
            meta.appendChild(badgeClone);
            badge.classList.add('fc-badge-original');
          }

          if (type === 'site') {
            var customerBadge = document.createElement('span');
            customerBadge.className = 'fc-customer-badge';
            customerBadge.textContent = 'Customer';
            meta.appendChild(customerBadge);
          }

          headerLeft.appendChild(avatar);
          headerLeft.appendChild(meta);

          var headerRight = document.createElement('div');
          headerRight.className = 'fc-card-header__right';

          if (dateText) {
            var dateNode = document.createElement('div');
            dateNode.className = 'fc-card-header__date';
            dateNode.textContent = dateText;
            headerRight.appendChild(dateNode);
          }

          header.appendChild(headerLeft);
          header.appendChild(headerRight);

          if (rating) {
            card.insertBefore(header, rating);
          } else {
            card.insertBefore(header, card.firstChild);
          }

          if (author) author.classList.add('fc-author-original');
          if (date) date.classList.add('fc-date-original');
        }

        function polishSiteReviewCard(card) {
          if (card.getAttribute('data-fc-polished') === 'true') return;

          var author = card.querySelector('.stamped-reviews-author');
          var date = card.querySelector('.stamped-reviews-date');
          var rating = card.querySelector('.stamped-reviews-rating');
          var badge = card.querySelector('.stamped-verified-label');

          card.classList.add('fc-site-review-card');

          buildHeader(card, author, date, badge, rating, 'site');

          if (badge) badge.classList.add('fc-badge-original');

          card.setAttribute('data-fc-polished', 'true');
        }

        function polishProductReviewCard(card, productNode) {
          if (card.getAttribute('data-fc-polished') === 'true') return;

          var author = card.querySelector('.stamped-reviews-author');
          var date = card.querySelector('.stamped-reviews-date');
          var message = card.querySelector('.stamped-reviews-message');
          var rating = card.querySelector('.stamped-reviews-rating');
          var badge = card.querySelector('.stamped-verified-label');

          var productText = productNode.textContent.trim();
          var productHref = findRealProductLink(productNode);

          buildHeader(card, author, date, badge, rating, 'product');

          var allImages = Array.prototype.slice.call(card.querySelectorAll('img')).filter(function (img) {
            return (
              !img.closest('.fc-card-header') &&
              !img.closest('.fc-purchased-item') &&
              !img.closest('.fc-review-gallery')
            );
          });

          var explicitReviewImages = Array.prototype.slice.call(
            card.querySelectorAll(
              '.stamped-review-image img, .stamped-review-images img, .stamped-review-gallery img, .stamped-reviews-image img'
            )
          );

          var productImage = null;

          if (allImages.length) {
            productImage = allImages.find(function (img) {
              var alt = (img.getAttribute('alt') || '').toLowerCase();
              return alt.indexOf('product image') !== -1;
            });

            if (!productImage) {
              productImage = allImages[0];
            }
          }

          var productImageUrl = getImageUrl(productImage);

          var reviewImages = allImages.filter(function (img) {
            return img !== productImage;
          });

          explicitReviewImages.forEach(function (img) {
            if (img !== productImage && reviewImages.indexOf(img) === -1) {
              reviewImages.push(img);
            }
          });

          if (productImage) {
            removeImageAndWrapper(productImage, card);
          }

          if (reviewImages.length) {
            var gallery = document.createElement('div');
            gallery.className = 'fc-review-gallery fc-generated-node';

            if (reviewImages.length === 1) {
              gallery.classList.add('fc-single-image');
            }

            var movedReviewNodes = [];

            reviewImages.forEach(function (img) {
              var imgUrl = getImageUrl(img);
              if (!imgUrl) return;

              var moveNode = getMovableReviewImageNode(img, card);
              if (!moveNode) return;

              if (movedReviewNodes.indexOf(moveNode) !== -1) return;
              movedReviewNodes.push(moveNode);

              moveNode.classList.add('fc-moved-review-image-node');

              img.classList.add('fc-clickable-review-image');
              img.style.display = '';
              img.style.height = '';
              img.style.width = '';
              img.style.opacity = '';
              img.style.visibility = '';
              img.style.pointerEvents = 'auto';
              moveNode.style.pointerEvents = 'auto';

              moveNode.addEventListener('click', function (event) {
                var clickable = img.closest('a, button, [role="button"]');

                if (clickable && clickable !== moveNode) {
                  clickable.dispatchEvent(
                    new MouseEvent('click', {
                      bubbles: true,
                      cancelable: true,
                      view: window,
                    })
                  );
                }
              });

              gallery.appendChild(moveNode);
            });

            if (gallery.children.length) {
              if (message) {
                message.insertAdjacentElement('afterend', gallery);
              } else {
                productNode.insertAdjacentElement('beforebegin', gallery);
              }
            }
          }

          var footer = document.createElement('a');
          footer.className = 'fc-purchased-item fc-generated-node';
          footer.href = productHref && productHref !== '#' ? productHref : 'javascript:void(0)';

          if (productNode.target) footer.target = productNode.target;
          if (productNode.rel) footer.rel = productNode.rel;

          if (productImageUrl) {
            var thumb = document.createElement('img');
            thumb.className = 'fc-purchased-item__image';
            thumb.src = productImageUrl;
            thumb.alt = productText;
            footer.appendChild(thumb);
          }

          var footerBody = document.createElement('div');
          footerBody.className = 'fc-purchased-item__body';

          var label = document.createElement('span');
          label.className = 'fc-purchased-item__label';
          label.textContent = 'Purchased Item';

          var title = document.createElement('span');
          title.className = 'fc-purchased-item__title';
          title.textContent = productText;

          footerBody.appendChild(label);
          footerBody.appendChild(title);

          var arrow = document.createElement('span');
          arrow.className = 'fc-purchased-item__arrow';
          arrow.innerHTML = '&rsaquo;';

          footer.appendChild(footerBody);
          footer.appendChild(arrow);

          footer.addEventListener('click', function (event) {
            if (productHref && productHref !== '#') {
              event.preventDefault();
              window.location.href = productHref;
            } else {
              productNode.click();
            }
          });

          productNode.classList.add('fc-hide-original-product-link');
          productNode.style.display = 'none';
          productNode.insertAdjacentElement('afterend', footer);

          removeTopBlankNodes(card);

          card.setAttribute('data-fc-polished', 'true');
        }

        function polishCards() {
          var grid = ensureGrid();
          if (!grid) return false;

          var cards = grid.querySelectorAll('.stamped-review-card, .stamped-ratings-wrapper.stamped-review-card');

          if (!cards.length) return false;

          cards.forEach(function (card) {
            if (card.getAttribute('data-fc-polished') === 'true') return;

            var productNode = card.querySelector('.stamped-products-reviews-title');

            if (productNode) {
              polishProductReviewCard(card, productNode);
            } else {
              polishSiteReviewCard(card);
            }
          });

          return true;
        }

        function normalizeReviewSummary() {
          var page = getPage();
          if (!page) return;

          var summary = page.querySelector('.stamped-widget-title');
          if (!summary) return;

          var rawText = summary.textContent.replace(/\s+/g, ' ').trim();
          if (!rawText) return;

          var numberMatches = rawText.match(/[\d,]+/g);
          if (!numberMatches || !numberMatches.length) return;

          var reviewCount = numberMatches[numberMatches.length - 1];

          summary.innerHTML =
            '<span class="fc-summary-stars">★★★★★</span>' +
            '<span>Based on <strong>' +
            reviewCount +
            '</strong> Reviews</span>';
        }

        function finishLoading(force) {
          var page = getPage();
          if (!page) return;

          var elapsed = Date.now() - FC_LOADING_STARTED_AT;

          if (!force && elapsed < 650) {
            if (FC_LOADING_TIMER) clearTimeout(FC_LOADING_TIMER);

            FC_LOADING_TIMER = setTimeout(function () {
              finishLoading(false);
            }, 180);

            return;
          }

          var hasCards =
            page.querySelectorAll(
              '.fc-stamped-review-grid > .stamped-review-card, .fc-stamped-review-grid > .stamped-ratings-wrapper.stamped-review-card'
            ).length > 0;

          var summary = page.querySelector('.stamped-widget-title');
          var hasSummary = !!(summary && summary.textContent.trim());

          if (!force && !hasCards && !hasSummary && elapsed < 2200) {
            return;
          }

          normalizeReviewSummary();

          page.classList.remove('fc-tabs-loading');
        }

        function scheduleLayout(delay) {
          if (FC_OBSERVER_TIMER) clearTimeout(FC_OBSERVER_TIMER);

          FC_OBSERVER_TIMER = setTimeout(function () {
            if (FC_STAMPED_RUNNING) return;

            FC_STAMPED_RUNNING = true;

            polishCards();
            sortReviewsWithImagesFirst();
            normalizeReviewSummary();
            finishLoading(false);

            FC_STAMPED_RUNNING = false;
          }, delay || 80);
        }

        function ensureLoader() {
          var page = getPage();
          if (!page) return;

          if (page.querySelector('.fc-review-loader')) return;

          var tabs = page.querySelector('.stamped-widget-buttons') || page.querySelector('.stamped-full-page-tabs');
          if (!tabs) return;

          var loader = document.createElement('div');
          loader.className = 'fc-review-loader';
          loader.innerHTML = '<div class="fc-review-loader__spinner"></div><div>Loading reviews...</div>';

          tabs.insertAdjacentElement('afterend', loader);
        }

        function startLoading() {
          var page = getPage();
          if (!page) return;

          ensureLoader();

          FC_LOADING_STARTED_AT = Date.now();

          page.classList.add('fc-tabs-loading');

          if (FC_LOADING_TIMER) clearTimeout(FC_LOADING_TIMER);

          FC_LOADING_TIMER = setTimeout(function () {
            finishLoading(true);
          }, 2600);
        }

        function handleTabClick(event) {
          var tabClick = event.target.closest(
            '#stamped-full-page .stamped-widget-buttons .stamped-full-page-tabs ul li, ' +
              '#stamped-full-page .stamped-widget-buttons .stamped-full-page-tabs ul li a'
          );

          if (!tabClick) return;

          var link = event.target.closest('a');
          if (link) {
            var href = link.getAttribute('href');
            if (!href || href === '#' || href.indexOf('#') === 0) {
              event.preventDefault();
            }
          }

          startLoading();

          resetAllCards();

          requestAnimationFrame(function () {
            scheduleLayout(40);
          });

          setTimeout(function () {
            scheduleLayout(80);
          }, 80);

          setTimeout(function () {
            scheduleLayout(160);
          }, 220);

          setTimeout(function () {
            scheduleLayout(250);
          }, 600);

          setTimeout(function () {
            finishLoading(true);
          }, 2600);
        }

        function init() {
          var page = getPage();
          if (!page) return;

          ensureLoader();

          setTimeout(function () {
            polishCards();
            sortReviewsWithImagesFirst();
            normalizeReviewSummary();
          }, 300);

          var observer = new MutationObserver(function (mutations) {
            var shouldRun = mutations.some(function (mutation) {
              if (!mutation.addedNodes || !mutation.addedNodes.length) return false;

              for (var i = 0; i < mutation.addedNodes.length; i++) {
                var node = mutation.addedNodes[i];

                if (node.nodeType !== 1) continue;

                if (
                  node.classList.contains('stamped-review-card') ||
                  node.classList.contains('stamped-ratings-wrapper') ||
                  node.querySelector('.stamped-review-card') ||
                  node.querySelector('.stamped-ratings-wrapper.stamped-review-card') ||
                  node.querySelector('.stamped-widget-title')
                ) {
                  return true;
                }
              }

              return false;
            });

            if (shouldRun) {
              scheduleLayout(80);
            }
          });

          observer.observe(page, {
            childList: true,
            subtree: true,
          });

          document.addEventListener('click', handleTabClick, true);
        }

        init();
      });
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var page = document.querySelector('#stamped-full-page');
        if (!page) return;

        function getTabs() {
          return Array.prototype.slice.call(
            page.querySelectorAll('.stamped-widget-buttons .stamped-full-page-tabs ul li')
          );
        }

        function getTabType(li) {
          var text = (li.textContent || '').toLowerCase();

          if (text.indexOf('site') !== -1) return 'site';
          if (text.indexOf('product') !== -1) return 'product';

          var link = li.querySelector('a');
          if (link && link.classList.contains('btn-site-reviews')) return 'site';

          return '';
        }

        function setActiveTabInstant(li) {
          var tabs = getTabs();

          tabs.forEach(function (tab) {
            tab.classList.remove('active');
            tab.setAttribute('aria-selected', 'false');

            var inner = tab.querySelector('a, button, span');
            if (inner) {
              inner.classList.remove('active');
              inner.setAttribute('aria-selected', 'false');
            }
          });

          li.classList.add('active');
          li.setAttribute('aria-selected', 'true');

          var innerActive = li.querySelector('a, button, span');
          if (innerActive) {
            innerActive.classList.add('active');
            innerActive.setAttribute('aria-selected', 'true');
          }
        }

        function triggerStampedTab(li, event) {
          var link = li.querySelector('a');
          var type = getTabType(li);

          if (link && event.target !== link && !event.target.closest('a')) {
            event.preventDefault();
            event.stopPropagation();

            setActiveTabInstant(li);

            link.click();
            return;
          }

          if (
            !link &&
            window.StampedWidgetFullPageFn &&
            typeof window.StampedWidgetFullPageFn.changeType === 'function'
          ) {
            event.preventDefault();
            event.stopPropagation();

            setActiveTabInstant(li);

            if (type === 'site') {
              window.StampedWidgetFullPageFn.changeType('full-page-nps');
            }

            if (type === 'product') {
              window.StampedWidgetFullPageFn.changeType('full-page');
            }
          }
        }

        document.addEventListener(
          'pointerdown',
          function (event) {
            var li = event.target.closest('#stamped-full-page .stamped-widget-buttons .stamped-full-page-tabs ul li');

            if (!li) return;

            setActiveTabInstant(li);
          },
          true
        );

        document.addEventListener(
          'click',
          function (event) {
            var li = event.target.closest('#stamped-full-page .stamped-widget-buttons .stamped-full-page-tabs ul li');

            if (!li) return;

            triggerStampedTab(li, event);
          },
          true
        );
      });
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        window.FC_REVIEW_CLICK_DEBUG = true;

        function fcDebug(label, data) {
          if (!window.FC_REVIEW_CLICK_DEBUG) return;
          console.log('%c[FC Review Click Debug] ' + label, 'color:#2563eb;font-weight:700;', data || '');
        }

        function describeEl(el) {
          if (!el) return null;

          var style = window.getComputedStyle(el);
          var rect = el.getBoundingClientRect();

          return {
            tag: el.tagName,
            id: el.id || '',
            className: typeof el.className === 'string' ? el.className : '',
            href: el.getAttribute ? el.getAttribute('href') : '',
            src: el.getAttribute ? el.getAttribute('src') : '',
            dataSrc: el.getAttribute ? el.getAttribute('data-src') : '',
            display: style.display,
            visibility: style.visibility,
            opacity: style.opacity,
            pointerEvents: style.pointerEvents,
            position: style.position,
            zIndex: style.zIndex,
            rect: {
              top: Math.round(rect.top),
              left: Math.round(rect.left),
              width: Math.round(rect.width),
              height: Math.round(rect.height),
            },
          };
        }

        function getModalInfo() {
          var modals = Array.prototype.slice.call(
            document.querySelectorAll(
              '.stamped-ugc-modal, .stamped-modal, .stamped-lightbox, [class*="stamped"][class*="modal"], [class*="stamped"][class*="lightbox"]'
            )
          );

          return modals.map(function (modal) {
            return describeEl(modal);
          });
        }

        function getAncestorChain(el) {
          var list = [];
          var current = el;

          while (current && current !== document.body && list.length < 10) {
            list.push(describeEl(current));
            current = current.parentElement;
          }

          return list;
        }

        document.addEventListener(
          'click',
          function (event) {
            var reviewImage = event.target.closest(
              '#stamped-full-page .fc-review-gallery img, #stamped-full-page .fc-moved-review-image-node, #stamped-full-page .fc-clickable-review-image'
            );

            var purchasedItem = event.target.closest('#stamped-full-page .fc-purchased-item');

            if (!reviewImage && !purchasedItem) return;

            var pointEl = document.elementFromPoint(event.clientX, event.clientY);

            fcDebug('1. Click captured', {
              clickedType: reviewImage ? 'review image' : 'purchased item',
              eventTarget: describeEl(event.target),
              elementFromPoint: describeEl(pointEl),
              sameTarget: pointEl === event.target || event.target.contains(pointEl),
            });

            if (reviewImage) {
              var movedNode = reviewImage.closest('.fc-moved-review-image-node');
              var clickableParent = reviewImage.closest('a, button, [role="button"]');
              var gallery = reviewImage.closest('.fc-review-gallery');

              fcDebug('2. Review image details', {
                reviewImage: describeEl(reviewImage),
                movedNode: describeEl(movedNode),
                clickableParent: describeEl(clickableParent),
                gallery: describeEl(gallery),
                ancestors: getAncestorChain(reviewImage),
              });

              setTimeout(function () {
                fcDebug('3. Modal after 300ms', {
                  modalCount: getModalInfo().length,
                  modals: getModalInfo(),
                });
              }, 300);

              setTimeout(function () {
                fcDebug('4. Modal after 1000ms', {
                  modalCount: getModalInfo().length,
                  modals: getModalInfo(),
                });
              }, 1000);
            }

            if (purchasedItem) {
              fcDebug('5. Purchased item details', {
                purchasedItem: describeEl(purchasedItem),
                href: purchasedItem.getAttribute('href'),
                text: purchasedItem.textContent.replace(/\s+/g, ' ').trim(),
                ancestors: getAncestorChain(purchasedItem),
              });

              setTimeout(function () {
                fcDebug('6. URL after product click', {
                  currentUrl: window.location.href,
                  href: purchasedItem.getAttribute('href'),
                });
              }, 500);
            }
          },
          true
        );

        fcDebug('Debug script loaded');
      });
    </script>

    <script>
      window.fcProductPhoneData = {
        hidePhoneNumber:
          
            false
          
      };

      window.fcCurrentResourcePhoneData = {
        pageType: "search",
        globalHidePhoneNumber:
        false,
        hidePhoneNumber:
          
              false
          
      };
    </script>

    

    <script id="fc-cart-phone-items-json" type="application/json">
        [
          
        ]
    </script>

    <script>
      (function () {
        if (window.fcPhoneHideScriptLoaded) return;
        window.fcPhoneHideScriptLoaded = true;

        var HIDE_KEY = 'fc_hide_phone_metafield';
        var RESOURCE_SESSION_KEY = 'fc_hide_phone_resource_session';
        var FORCE_SHOW_KEY = 'fc_phone_force_visible_false_item';
        var BODY_CLASS = 'fc-hide-phone-for-wall-base';

        function getCartItemsFromPage() {
          try {
            var jsonScript = document.getElementById('fc-cart-phone-items-json');
            if (!jsonScript) return [];

            return JSON.parse(jsonScript.textContent || '[]');
          } catch (e) {
            return [];
          }
        }

        window.fcCartPhoneItems = getCartItemsFromPage();

        function isTrueValue(value) {
          return value === true || String(value).toLowerCase() === 'true';
        }

        function isCurrentProductPhoneHidden() {
          var productPhoneData = window.fcProductPhoneData || {};
          return isTrueValue(productPhoneData.hidePhoneNumber);
        }

        function isGlobalPhoneHidden() {
          var resourcePhoneData = window.fcCurrentResourcePhoneData || {};

          return isTrueValue(resourcePhoneData.globalHidePhoneNumber);
        }

        function isCurrentResourcePhoneHidden() {
          var resourcePhoneData = window.fcCurrentResourcePhoneData || {};

          return isTrueValue(resourcePhoneData.hidePhoneNumber);
        }

        function isResourceSessionPhoneHidden() {
          return sessionStorage.getItem(RESOURCE_SESSION_KEY) === 'true';
        }

        function rememberCurrentResourceHideState() {
          if (isCurrentResourcePhoneHidden()) {
            sessionStorage.setItem(RESOURCE_SESSION_KEY, 'true');
          }
        }

        function cartHasAnyTruePhoneItem(items) {
          return items.some(function (item) {
            return isTrueValue(item.hidePhoneNumber);
          });
        }

        function cartHasAnyFalsePhoneItem(items) {
          return items.some(function (item) {
            return !isTrueValue(item.hidePhoneNumber);
          });
        }

        function cartHasOnlyTruePhoneItems(items) {
          if (!items.length) return false;

          return cartHasAnyTruePhoneItem(items) && !cartHasAnyFalsePhoneItem(items);
        }

        function hideMobilePhoneElements() {
          var wrappers = document.querySelectorAll('.mobile-menu__help-wrapper');

          wrappers.forEach(function (wrapper) {
            if (wrapper.querySelector('.icon--bi-phone')) {
              wrapper.style.display = 'none';
              wrapper.style.visibility = 'hidden';
              wrapper.style.pointerEvents = 'none';
            }
          });
        }

        function restoreMobilePhoneElements() {
          var wrappers = document.querySelectorAll('.mobile-menu__help-wrapper');

          wrappers.forEach(function (wrapper) {
            if (wrapper.querySelector('.icon--bi-phone')) {
              wrapper.style.display = '';
              wrapper.style.visibility = '';
              wrapper.style.pointerEvents = '';
            }
          });
        }

        function hidePhone() {
          document.documentElement.classList.add(BODY_CLASS);

          if (document.body) {
            document.body.classList.add(BODY_CLASS);
          }

          hideMobilePhoneElements();
        }

        function showPhone() {
          document.documentElement.classList.remove(BODY_CLASS);

          if (document.body) {
            document.body.classList.remove(BODY_CLASS);
          }

          restoreMobilePhoneElements();
        }

        function preparePhoneStateBeforeAddToCart() {
          var cartItems = window.fcCartPhoneItems || [];

          rememberCurrentResourceHideState();

          if (isGlobalPhoneHidden()) {
            hidePhone();
            return;
          }

          if (!isCurrentProductPhoneHidden()) {
            sessionStorage.setItem(FORCE_SHOW_KEY, 'true');
            sessionStorage.removeItem(HIDE_KEY);
            showPhone();
            return;
          }

          if (cartHasAnyFalsePhoneItem(cartItems)) {
            sessionStorage.setItem(FORCE_SHOW_KEY, 'true');
            sessionStorage.removeItem(HIDE_KEY);
            showPhone();
            return;
          }

          sessionStorage.removeItem(FORCE_SHOW_KEY);
          sessionStorage.setItem(HIDE_KEY, 'true');
          hidePhone();
        }

        function setupAddToCartPreSubmitWatcher() {
          document.addEventListener(
            'submit',
            function (event) {
              var form = event.target;

              if (!form || !form.matches('form[action*="/cart/add"]')) {
                return;
              }

              preparePhoneStateBeforeAddToCart();
            },
            true
          );

          document.addEventListener(
            'click',
            function (event) {
              var button = event.target.closest(
                'button[name="add"], button[type="submit"], input[type="submit"], .product-form__add-button'
              );

              if (!button) return;

              var form = button.closest('form');

              if (!form || !form.matches('form[action*="/cart/add"]')) {
                return;
              }

              preparePhoneStateBeforeAddToCart();
            },
            true
          );
        }

        function applyFinalPhoneState(items) {
          items = Array.isArray(items) ? items : [];

          rememberCurrentResourceHideState();

          if (isGlobalPhoneHidden()) {
            hidePhone();
            return;
          }

          if (cartHasAnyFalsePhoneItem(items)) {
            sessionStorage.setItem(FORCE_SHOW_KEY, 'true');
            sessionStorage.removeItem(HIDE_KEY);
            showPhone();
            return;
          }

          if (cartHasOnlyTruePhoneItems(items)) {
            sessionStorage.removeItem(FORCE_SHOW_KEY);
            sessionStorage.setItem(HIDE_KEY, 'true');
            hidePhone();
            return;
          }

          sessionStorage.removeItem(FORCE_SHOW_KEY);
          sessionStorage.removeItem(HIDE_KEY);

          if (isCurrentResourcePhoneHidden() || isResourceSessionPhoneHidden()) {
            hidePhone();
            return;
          }

          showPhone();
        }

        function parseCartPhoneItemsFromHtml(html) {
          try {
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, 'text/html');
            var jsonScript = doc.getElementById('fc-cart-phone-items-json');

            if (!jsonScript) return null;

            return JSON.parse(jsonScript.textContent || '[]');
          } catch (e) {
            return null;
          }
        }

        function refreshCartPhoneState() {
          fetch('/cart', {
            method: 'GET',
            credentials: 'same-origin',
          })
            .then(function (response) {
              return response.text();
            })
            .then(function (html) {
              var updatedItems = parseCartPhoneItemsFromHtml(html);

              if (!Array.isArray(updatedItems)) {
                applyFinalPhoneState(window.fcCartPhoneItems || []);
                return;
              }

              window.fcCartPhoneItems = updatedItems;
              applyFinalPhoneState(updatedItems);
            })
            .catch(function () {
              applyFinalPhoneState(window.fcCartPhoneItems || []);
            });
        }

        function setupCartAjaxWatcher() {
          var originalFetch = window.fetch;

          if (originalFetch) {
            window.fetch = function () {
              var fetchArgs = arguments;
              var url = String(fetchArgs[0] || '');

              if (url.indexOf('/cart/add') !== -1) {
                preparePhoneStateBeforeAddToCart();
              }

              return originalFetch.apply(this, fetchArgs).then(function (response) {
                if (
                  url.indexOf('/cart/add') !== -1 ||
                  url.indexOf('/cart/change') !== -1 ||
                  url.indexOf('/cart/update') !== -1 ||
                  url.indexOf('/cart/clear') !== -1
                ) {
                  setTimeout(refreshCartPhoneState, 150);
                }

                return response;
              });
            };
          }

          var originalOpen = XMLHttpRequest.prototype.open;
          var originalSend = XMLHttpRequest.prototype.send;

          XMLHttpRequest.prototype.open = function (method, url) {
            this.fcCartUrl = String(url || '');
            return originalOpen.apply(this, arguments);
          };

          XMLHttpRequest.prototype.send = function () {
            var url = this.fcCartUrl || '';

            if (url.indexOf('/cart/add') !== -1) {
              preparePhoneStateBeforeAddToCart();
            }

            this.addEventListener('load', function () {
              var requestUrl = this.fcCartUrl || '';

              if (
                requestUrl.indexOf('/cart/add') !== -1 ||
                requestUrl.indexOf('/cart/change') !== -1 ||
                requestUrl.indexOf('/cart/update') !== -1 ||
                requestUrl.indexOf('/cart/clear') !== -1
              ) {
                setTimeout(refreshCartPhoneState, 150);
              }
            });

            return originalSend.apply(this, arguments);
          };
        }

        function setupMobileMenuObserver() {
          if (!document.body) return;

          var observer = new MutationObserver(function () {
            if (
              document.documentElement.classList.contains(BODY_CLASS) ||
              document.body.classList.contains(BODY_CLASS)
            ) {
              hideMobilePhoneElements();
            }
          });

          observer.observe(document.body, {
            childList: true,
            subtree: true,
          });
        }

        setupAddToCartPreSubmitWatcher();
        applyFinalPhoneState(window.fcCartPhoneItems || []);

        document.addEventListener('DOMContentLoaded', function () {
          applyFinalPhoneState(window.fcCartPhoneItems || []);

          setupCartAjaxWatcher();
          setupMobileMenuObserver();
          refreshCartPhoneState();
        });
      })();
    </script>
    

    <script>
      (function () {
        try {
          var gclid = new URLSearchParams(window.location.search).get('gclid');

          if (gclid && gclid !== '[object Object]') {
            sessionStorage.setItem('google_gclid', gclid.trim());
            console.log('Global GCLID captured:', gclid.trim());
          }
        } catch (e) {
          console.error('Global GCLID capture error:', e);
        }
