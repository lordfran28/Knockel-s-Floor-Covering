    <script>
      (function () {
        var ATTRIBUTION_EXPIRY_MS = 28 * 24 * 60 * 60 * 1000;
        var urlParams = new URLSearchParams(window.location.search);
        var currentFbclid = urlParams.get('fbclid') || '';

        function getCookie(name) {
          try {
            var cookies = document.cookie ? document.cookie.split(';') : [];

            for (var i = 0; i < cookies.length; i++) {
              var cookie = cookies[i].trim();
              var prefix = name + '=';

              if (cookie.indexOf(prefix) === 0) {
                return decodeURIComponent(cookie.substring(prefix.length));
              }
            }
          } catch (error) {
            console.warn('[attribution] Could not read cookie:', name);
          }

          return '';
        }

        function readStoredValue(key) {
          try {
            var raw = localStorage.getItem(key);

            if (!raw) {
              return '';
            }

            var parsed = JSON.parse(raw);
            var timestamp = Number(parsed.ts || 0);

            if (!timestamp || Date.now() - timestamp >= ATTRIBUTION_EXPIRY_MS) {
              localStorage.removeItem(key);
              return '';
            }

            if (parsed.value === null || typeof parsed.value === 'undefined') {
              return '';
            }

            return String(parsed.value).trim();
          } catch (error) {
            try {
              localStorage.removeItem(key);
            } catch (removeError) {}

            return '';
          }
        }

        function storeValue(key, value) {
          if (!value) {
            return;
          }

          try {
            localStorage.setItem(
              key,
              JSON.stringify({
                value: String(value).trim(),
                ts: Date.now(),
              })
            );
          } catch (error) {
            console.warn('[attribution] Could not write localStorage:', key);
          }
        }

        function removeStoredValue(key) {
          try {
            localStorage.removeItem(key);
          } catch (error) {}
        }

        function fbcMatchesFbclid(fbc, fbclid) {
          if (!fbc || !fbclid) {
            return false;
          }

          return fbc.slice(-(fbclid.length + 1)) === '.' + fbclid;
        }

        function getFirstTouchUtm(key) {
          var storageKey = 'fc_' + key;
          var storedValue = readStoredValue(storageKey);

          if (storedValue) {
            return storedValue;
          }

          var incomingValue = urlParams.get(key);

          if (incomingValue) {
            storeValue(storageKey, incomingValue);
            return incomingValue;
          }

          return '';
        }

        function updateCartAttributes(attributes) {
          if (!attributes || Object.keys(attributes).length === 0) {
            return Promise.resolve();
          }

          return fetch('/cart/update.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              attributes: attributes,
            }),
          })
            .then(function (response) {
              if (!response.ok) {
                throw new Error('Cart update failed with status ' + response.status);
              }

              return response.json();
            })
            .catch(function (error) {
              console.warn('[attribution] Cart update failed:', error);
            });
        }

        if (currentFbclid) {
          removeStoredValue('fc_fbc');
        }

        var pixelFbc = getCookie('_fbc');

        if (currentFbclid) {
          if (fbcMatchesFbclid(pixelFbc, currentFbclid)) {
            storeValue('fc_fbc', pixelFbc);
          } else {
            storeValue('fc_fbc', 'fb.1.' + Date.now() + '.' + currentFbclid);
          }
        } else if (pixelFbc) {
          storeValue('fc_fbc', pixelFbc);
        }

        var pixelFbp = getCookie('_fbp');

        if (pixelFbp) {
          storeValue('fc_fbp', pixelFbp);
        }

        var cartAttributes = {};

        var gclid = urlParams.get('gclid');
        var msclkid = urlParams.get('msclkid');

        if (gclid) {
          cartAttributes.gclid = gclid;
        }

        if (msclkid) {
          cartAttributes.msclkid = msclkid;
        }

        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (key) {
          var value = getFirstTouchUtm(key);

          if (value) {
            cartAttributes[key] = value;
          }
        });

        var storedFbc = readStoredValue('fc_fbc');
        var storedFbp = readStoredValue('fc_fbp');

        if (storedFbc) {
          cartAttributes.fbc = storedFbc;
        }

        if (storedFbp) {
          cartAttributes.fbp = storedFbp;
        }

        updateCartAttributes(cartAttributes);

        setTimeout(function () {
          var delayedAttributes = {};
          var delayedFbc = getCookie('_fbc');
          var delayedFbp = getCookie('_fbp');
          var currentStoredFbc = readStoredValue('fc_fbc');
          var currentStoredFbp = readStoredValue('fc_fbp');

          var delayedFbcIsUsable = delayedFbc && (!currentFbclid || fbcMatchesFbclid(delayedFbc, currentFbclid));

          if (delayedFbcIsUsable && delayedFbc !== currentStoredFbc) {
            storeValue('fc_fbc', delayedFbc);
            delayedAttributes.fbc = delayedFbc;
          }

          if (delayedFbp && delayedFbp !== currentStoredFbp) {
            storeValue('fc_fbp', delayedFbp);
            delayedAttributes.fbp = delayedFbp;
          }

          updateCartAttributes(delayedAttributes);
        }, 1500);
      })();
    </script>

    
