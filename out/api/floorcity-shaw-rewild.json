    window.fcOpenVanChat = function () {
      var tries = 0;
      (function attempt() {
        if (window.vanchat_widget && typeof window.vanchat_widget.open === 'function') { window.vanchat_widget.open(); return; }
        var btn = document.querySelector('.vc2-launcher, .vc2-launcher-left, .vc-animation-container, .vc-animation-container-left');
        if (btn) { btn.click(); return; }
        if (++tries < 30) setTimeout(attempt, 200); else console.warn('VanChat launcher not found');
      })();
    };
    document.addEventListener('click', function (e) {
      var t = e.target.closest && e.target.closest('#open-vanchat');
      if (!t) return;
      e.preventDefault();
      window.fcOpenVanChat();
    });
