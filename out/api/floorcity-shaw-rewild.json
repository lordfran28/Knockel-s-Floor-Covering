          var FORCE_SHOW_KEY = 'fc_phone_force_visible_false_item';
          var BODY_CLASS = 'fc-hide-phone-for-wall-base';

          var forceShow =
            sessionStorage.getItem(FORCE_SHOW_KEY) === 'true';

          var storedHide =
            sessionStorage.getItem(HIDE_KEY) === 'true';

          var resourceSessionHide =
            sessionStorage.getItem(RESOURCE_SESSION_KEY) === 'true';

          var globalHidePhone =
            false;
          var currentResourceHidePhone = false;

          globalHidePhone =
            globalHidePhone === true ||
            String(globalHidePhone).toLowerCase() === 'true';

          

          currentResourceHidePhone =
            currentResourceHidePhone === true ||
            String(currentResourceHidePhone).toLowerCase() === 'true';

          if (currentResourceHidePhone) {
            sessionStorage.setItem(RESOURCE_SESSION_KEY, 'true');
            resourceSessionHide = true;
          }

          var shouldHide =
            globalHidePhone ||
            (
              !forceShow &&
              (
                currentResourceHidePhone ||
                resourceSessionHide ||
                storedHide
              )
            );

          document.documentElement.classList.toggle(
            BODY_CLASS,
            shouldHide
          );
        } catch (error) {
          console.error('Early phone visibility error:', error);
        }
      })();
    </script>
    

    

    
